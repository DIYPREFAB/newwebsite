    },
    {
      "source": "/project-case-studies/project-gallery",
      "destination": "/index.html"
    },
    {
      "source": "/project-case-studies/hall-of-fame",
      "destination": "/index.html"
    },
    {
      "source": "/blog-news",
      "destination": "/index.html"
    },
    {
      "source": "/blog-news/industry-trends",
      "destination": "/index.html"
    },
    {
      "source": "/blog-news/construction-tips-tricks",
      "destination": "/index.html"
    },
    {
      "source": "/blog-news/sustainability-in-prefab",
