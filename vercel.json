{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/product-services",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/project-case-studies",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/introduction-to-diy-prefab-solutions",
      "destination": "/key-benefits-of-prefab-construction",
      "permanent": true
    },
    {
      "source": "/featured-projects",
      "destination": "/project-case-studies",
      "permanent": true
    },
    {
      "source": "/generate-sitemap",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/key-benefits-of-prefab-construction",
      "destination": "/index.html"
    },
    {
      "source": "/about-us",
      "destination": "/index.html"
    },
